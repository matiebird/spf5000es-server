[MODBUS]
PORT = /dev/ttyUSB0
TIMEOUT_SEC = 1.5

[LOGGING]
LEVEL = INFO

[MQTT]
HOST = localhost
PORT = 1883
USER =
PASSWORD =
TLS_ENABLED = false
TLS_CA_FILE =
TLS_CERT_FILE =
TLS_KEY_FILE =
TLS_SERVER_NAME =
CLIENT_ID = growatt_spf5000es
KEEPALIVE_SEC = 60
WILL_DELAY_SEC = 300
OPERATION_TIMEOUT_SEC = 10
DISCONNECT_TIMEOUT_SEC = 5
TOPIC_PREFIX = growatt/spf5000es
HA_DISCOVERY_PREFIX = homeassistant
HA_DEVICE_ID = growatt_spf5000es
HA_DEVICE_NAME = Growatt SPF 5000 ES

[POLLING]
CONFIG_INTERVAL_SEC = 600
STATUS_INTERVAL_SEC = 2

[RECOVERY]
RECONNECT_ATTEMPTS = 3
INITIAL_BACKOFF_SEC = 1
MAX_BACKOFF_SEC = 10
RESET_COOLDOWN_SEC = 300
