// Permit only the unprivileged server account to start the fixed USB-reset unit.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "spf5000es-recovery.service" &&
        action.lookup("verb") == "start" &&
        subject.user == "spf5000es") {
        return polkit.Result.YES;
    }
});
